# 이 파일을 같은 폴더에 .env 로 복사한 뒤 값을 채운다. .env 는 Git에 올리지 않는다.

# 서버 주소 (학교 도메인 아래 주소, https:// 없이)
DOMAIN=moa.samjeong.ms.kr
# DB 비밀번호: 길고 무작위로 (예: PowerShell에서 [guid]::NewGuid().ToString('N'))
POSTGRES_PASSWORD=

# Google 로그인 (Google Cloud 콘솔의 기존 OAuth 클라이언트에 리디렉션 URI를 추가해 그대로 사용 가능)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 교사·관리자 (운영 Worker의 wrangler.jsonc 값과 같게)
TEACHER_ADMISSION=allowlist
TEACHER_EMAILS=xopowok08@samjeong.ms.kr
ADMIN_EMAILS=xopowok08@samjeong.ms.kr
TEACHER_GROUP_EMAIL=allsamjeong@samjeong.ms.kr
GOOGLE_DIRECTORY_SUBJECT=xopowok08@samjeong.ms.kr
# 교사 그룹 확인용 서비스 계정 키(JSON 한 줄). 비워 두면 명단에 없는 학교 계정의 교사 로그인이 503으로 안내된다.
GOOGLE_DIRECTORY_KEY=
