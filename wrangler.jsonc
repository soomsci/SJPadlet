{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samjeong-moa",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "alias": {
    "@db": "./packages/db/worker.ts"
  },
  "vars": {
    "APP_URL": "https://samjeong-moa.samjeong-moa.workers.dev",
    "TEACHER_ADMISSION": "allowlist",
    "TEACHER_EMAILS": "xopowok08@samjeong.ms.kr",
    "ADMIN_EMAILS": "xopowok08@samjeong.ms.kr",
    "FREE_TIER_MODE": "true",
    "MEDIA_BACKEND": "supabase",
    "SUPABASE_URL": "https://YOUR_PROJECT.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "",
    "SUPABASE_STORAGE_BUCKET": "classroom-images"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 0.1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "secrets": {
    "required": [
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "SUPABASE_SECRET_KEY",
      "SUPABASE_SIGNING_JWK"
    ]
  },
  "account_id": "7577f586f44b23fbc4ebf27e21d19a70"
}
