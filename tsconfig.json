{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"], "strict": true,
    "skipLibCheck": true, "noEmit": true, "esModuleInterop": true, "module": "esnext",
    "moduleResolution": "bundler", "resolveJsonModule": true, "isolatedModules": true,
    "jsx": "react-jsx", "baseUrl": ".", "plugins": [{"name":"next"}],
    "paths": {"@contracts":["packages/contracts/index.ts"], "@db":["packages/db/index.ts"],
      "@server/*":["packages/server/*"], "@features/*":["apps/web/src/features/*"], "@ui":["packages/ui/index.tsx"]}
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "packages/**/*.tsx", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
