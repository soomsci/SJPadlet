APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TEACHER_ADMISSION=allowlist
TEACHER_EMAILS=
ADMIN_EMAILS=
# Set DATABASE_URL for production PostgreSQL. Otherwise local PGlite is used.
DATABASE_URL=
DATABASE_PATH=.data/postgres
UPLOAD_PATH=.data/uploads
# Development-only demo entry; ignored in production.
ENABLE_DEMO_LOGIN=true
# Production uploads stay quarantined until scanner integration is configured.
CLAMAV_HOST=
CLAMAV_PORT=3310

# Optional free-mode parity in the Node development server.
FREE_TIER_MODE=false
MEDIA_BACKEND=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=classroom-images
SUPABASE_SIGNING_JWK=
