{
  "name": "samjeong-board",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --ip 127.0.0.1",
    "build": "vite build",
    "start": "wrangler dev --ip 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/worker/tsconfig.json",
    "lint": "eslint apps packages tests scripts",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run cf:dry-run && npm run cf:smoke",
    "db:backup": "tsx scripts/backup.ts",
    "db:restore": "tsx scripts/backup.ts restore",
    "dev:free": "wrangler dev --ip 127.0.0.1",
    "build:free": "vite build",
    "check:free": "npm run check",
    "cf:types": "wrangler types apps/worker/worker-configuration.d.ts --include-runtime false --strict-vars false",
    "cf:dry-run": "wrangler deploy --dry-run --outdir dist/worker",
    "cf:smoke": "node scripts/smoke-worker.mjs",
    "cf:whoami": "wrangler whoami",
    "cf:login": "wrangler login",
    "deploy:free": "node --import tsx scripts/deploy-free.mjs",
    "deploy:setup": "node --import tsx scripts/setup-free-deployment.ts",
    "db:migrate:free": "node --import tsx scripts/migrate-free.ts",
    "db:generate:free": "node --import tsx scripts/generate-free-migration.ts",
    "dev:node": "next dev apps/web --hostname 0.0.0.0",
    "build:node": "next build apps/web --webpack",
    "start:node": "next start apps/web --hostname 0.0.0.0",
    "cf:agent:setup": "node scripts/setup-cloudflare-agent.mjs",
    "cf:realtime-key": "node scripts/create-realtime-key.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@supabase/supabase-js": "2.117.3",
    "google-auth-library": "^10.5.0",
    "jose": "6.2.12",
    "lucide-react": "^0.562.0",
    "next": "^16.1.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "30.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.3.4",
    "vitest": "^4.0.16",
    "workerd": "1.20261006.1",
    "wrangler": "4.149.0"
  },
  "type": "module"
}
